# Local development settings (copy to .env). Matches `npm run db:dev`.
DB_HOST=127.0.0.1
DB_PORT=33306
DB_USER=root
DB_PASSWORD=
DB_NAME=bloom
# Dev-only values; production uses its own secrets on playground.
SESSION_SECRET=dev-only-session-secret-change-me-000000
CREDENTIALS_KEY=dev-only-credentials-key
# Where one-time sign-in links point: the Vite dev server.
PUBLIC_URL=http://localhost:5173
PORT=8080
# Local only: gives every admin in the local database this password on start, so you can
# sign in without a setup link. Ignored when NODE_ENV=production or PUBLIC_URL isn't localhost.
DEV_ADMIN_PASSWORD=dev

# Integration tokens for local development. The server uses these when a token isn't saved in
# Settings (the local database is reset on every restart, so Settings wouldn't keep them).
# Paste your own tokens; this file is git-ignored. Restart the API after editing.
FIGMA_ACCESS_TOKEN=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_WORKSPACE=
GETDX_API_TOKEN=
# Powers "Ask the data" in the Insights panels (platform.claude.com → API keys).
ANTHROPIC_API_KEY=

# Local only: set to 1 for made-up Figma data (no token needed). Ignored in production and off localhost;
# the code lives in server/dev, which is left out of the production image.
FIGMA_FAKE_DATA=
