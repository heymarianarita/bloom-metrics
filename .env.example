# Local development settings (copy to .env). Matches `npm run db:dev`.
DB_HOST=127.0.0.1
DB_PORT=33306
DB_USER=root
DB_PASSWORD=
DB_NAME=bloom
# Dev-only values; production uses its own secrets on playground.
SESSION_SECRET=dev-only-session-secret-change-me-000000
CREDENTIALS_KEY=dev-only-credentials-key
# Where one-time sign-in links point: the Vite dev server.
PUBLIC_URL=http://localhost:5173
PORT=8080
# Local only: gives every admin in the local database this password on start, so you can
# sign in without a setup link. Ignored when NODE_ENV=production or PUBLIC_URL isn't localhost.
DEV_ADMIN_PASSWORD=dev
